# --- Claude ---
# Not required for normal operation: ingest workers and the headless
# orchestrator shell out to the locally-installed `claude` CLI and ride your
# existing Claude Code subscription (see services/ingest/scriptorium_ingest/claude_cli.py).
# Only set this if you specifically want a direct, separately-billed Anthropic API call somewhere.
# ANTHROPIC_API_KEY=sk-ant-...
# --- Database ---
# SQLite file; default is fine for a single machine (data/scriptorium.db).
# SCRIPTORIUM_DB_PATH=
# --- Literature APIs (all optional but recommended) ---
OPENALEX_EMAIL=you@university.ca
UNPAYWALL_EMAIL=you@university.ca
S2_API_KEY=
# --- Embeddings ---
VOYAGE_API_KEY=
# --- Library connectors (per professor, opt-in) ---
ZOTERO_USER_ID=
ZOTERO_API_KEY=
# --- Institutional TDM keys (via your library; see docs/COMPLIANCE.md) ---
ELSEVIER_TDM_KEY=
SPRINGER_API_KEY=
